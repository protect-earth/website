PUBLIC_MAPBOX_TOKEN=

# Shopify Storefront API (headless store spike; the token is public-safe)
PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your-storefront-access-token
PUBLIC_SHOPIFY_API_VERSION=2026-10

# Notion API Configuration (only needed to run scripts/sync-*.js)
NOTION_API_KEY=ntn_your_key_here
NOTION_SITE_UPDATES_DB_ID=your_database_id_here

# Eventbrite API Configuration (only needed to run scripts/sync-events.js)
EVENTBRITE_PRIVATE_TOKEN=your-private-token
EVENTBRITE_ORGANIZATION_ID=optional-organization-id
EVENTBRITE_EVENT_STATUSES=live,started

# Mailchimp API Configuration
MAILCHIMP_API_KEY=your-api-key-here
MAILCHIMP_SERVER_PREFIX=us2 # just the shortcode is needed, eg. "us2" for "us2.api.mailchimp.com"
MAILCHIMP_AUDIENCE_ID=your-audience-id # 10 digits
MAILCHIMP_GROUP_ID_GENERAL=your-general-group-id # 10 digits
MAILCHIMP_GROUP_ID_VOLUNTEER=your-volunteer-group-id # 10 digits
