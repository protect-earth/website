---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config';
import ContentHero from '../components/ContentHero.astro';
import { heroPeopleFamilies } from '../assets/hero-images';

const desc =
	"Contact Us. We'd love to hear from you. Whether you're interested in volunteering, have land to offer, or want to support our work, please get in touch.";
---

<Layout title="Contact" className="page-contact" description={desc}>
	<ContentHero
		title="Contact Us"
		imgSrc={heroPeopleFamilies}
		imgAlt="Group of people outdoors planting trees on a hillside"
	/>

	<section class="page-sections wrap">
		<div class="columns">
			<form
				name="contact"
				method="POST"
				data-netlify="true"
				netlify-honeypot="bot-field"
				class="squircle stack"
			>
				<input type="hidden" name="form-name" value="contact" />

				<p>
					We'd love to hear from you. Whether you're interested in volunteering, have land to offer,
					or want to support our work, please get in touch.
				</p>

				<!-- Hidden honeypot field for spam protection -->
				<p style="display: none;">
					<label>
						Don't fill this out if you're human: <input name="bot-field" />
					</label>
				</p>

				<div class="form-message" data-message-container></div>

				<fieldset>
					<div class="inline-group">
						<div>
							<label for="name">
								Name <span class="field-required">*</span>
							</label>
							<input type="text" id="name" name="name" required />
						</div>

						<div>
							<label for="email">
								Email <span class="field-required">*</span>
							</label>
							<input type="email" id="email" name="email" required />
						</div>
					</div>
				</fieldset>

				<fieldset>
					<label for="topic">
						What would you like to discuss with us? <span class="field-required">*</span>
					</label>
					<select id="topic" name="topic" required>
						<option value="">Please select...</option>
						<option value="planting">Planting</option>
						<option value="financing">Financing</option>
						<option value="land">Land</option>
						<option value="other">Other</option>
					</select>
				</fieldset>

				<fieldset>
					<label for="message">
						Message <span class="field-required">*</span>
					</label>
					<textarea id="message" name="message" rows="6" required></textarea>
				</fieldset>

				<fieldset>
					<button type="submit" class="button">Send Message</button>
				</fieldset>

				<small>
					We'll get back to you as soon as possible. All fields marked with <span
						class="field-required">*</span
					> are required.
				</small>
			</form>

			<div class="contact-info squircle prose stack">
				<h3>Email</h3>
				<p><a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a></p>

				<h3>Phone</h3>
				<p>
					<a href={siteConfig.contact.phone.link} ref="tel">{siteConfig.contact.phone.label}</a>
				</p>

				<p>
					<strong>Charity Number</strong>
					<span>{siteConfig.charityNumber}</span>
				</p>

				<h2>Follow Us</h2>
				<ul>
					<li>
						<a href={siteConfig.social.threads} target="_blank" rel="noopener noreferrer">
							Threads
						</a>
					</li>
					<li>
						<a href={siteConfig.social.instagram} target="_blank" rel="noopener noreferrer">
							Instagram
						</a>
					</li>
					<li>
						<a href={siteConfig.social.facebook} target="_blank" rel="noopener noreferrer">
							Facebook
						</a>
					</li>
				</ul>
			</div>
		</div>
	</section>

	<section class="page-sections wrap">
		<header>
			<h2>Ways to Get Involved</h2>
		</header>

		<nav class="grid">
			<div class="section-card">
				<a href="/get-involved/people-families">
					<h3>Volunteer</h3>
					<p>Join us at tree planting events and woodland maintenance days</p>
				</a>
			</div>

			<div class="section-card">
				<a href="/act-now/general-donation">
					<h3>Donate</h3>
					<p>Support our work creating and restoring woodlands across the UK</p>
				</a>
			</div>

			<div class="section-card">
				<a href="/get-involved/landowners">
					<h3>Landowners</h3>
					<p>Have land you'd like to see transformed into woodland?</p>
				</a>
			</div>
		</nav>
	</section>
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const form = document.querySelector('form[name="contact"]') as HTMLFormElement | null;
		const messageContainer = document.querySelector(
			'[data-message-container]',
		) as HTMLElement | null;
		const submitButton = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

		if (!form || !messageContainer || !submitButton) return;

		form.addEventListener('submit', async (e) => {
			e.preventDefault();

			// Disable submit button and show loading state
			submitButton.disabled = true;
			const originalText = submitButton.textContent;
			submitButton.textContent = 'Sending...';

			// Hide any previous messages
			messageContainer.removeAttribute('data-status');
			messageContainer.textContent = '';

			try {
				const formData = new FormData(form);

				const response = await fetch('/', {
					method: 'POST',
					headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
					body: new URLSearchParams(formData as any).toString(),
				});

				if (response.ok) {
					// Show success message with animation
					messageContainer.textContent =
						"Thank you! Your message has been sent successfully. We'll get back to you soon.";
					messageContainer.setAttribute('data-status', 'success');

					// Reset form
					form.reset();

					// Scroll to message
					messageContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
				} else {
					throw new Error('Form submission failed');
				}
			} catch (error) {
				// Show error message
				messageContainer.textContent =
					'Sorry, something went wrong. Please try again or email us directly at help@protect.earth.';
				messageContainer.setAttribute('data-status', 'error');
			} finally {
				// Re-enable submit button
				submitButton.disabled = false;
				submitButton.textContent = originalText;
			}
		});
	});
</script>

<style>
	.contact-info {
		background: var(--white);
		padding: var(--space-l);
	}

	form {
		max-width: auto;
	}

	.columns {
		display: grid;
		grid-template-columns: 44rem 1fr;
		gap: var(--space-xl);

		@media screen and (max-width: 844px) {
			grid-template-columns: 1fr;
			gap: var(--space-l);
		}
	}
</style>
