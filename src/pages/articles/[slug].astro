---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TakeAction from '../../components/TakeAction.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import { getCategoryName } from '../../helpers';
import type { CategorySlug } from '../../helpers';

export async function getStaticPaths() {
	const articles = await getCollection('articles');

	return articles.map((article) => ({
		params: { slug: article.id.replace(/\.(md|mdx)$/i, '') },
	}));
}

const { slug } = Astro.params;
const articles = await getCollection('articles');
const article = articles.find((entry) => entry.id.replace(/\.(md|mdx)$/i, '') === slug);

if (!article) {
	return Astro.rewrite('/404');
}

const {
	data: { author, description, pubDate, title, thumbnail, categories },
} = article;
const { Content } = await render(article);
---

<Layout {title} {description} breadcrumb={title}>
	<!-- Hero Section -->
	<article class="post">
		<header>
			<div class="wrap">
				<h1>{title}</h1>
				{
					categories && categories.length > 0 && (
						<div class="categories">
							{categories.map((category: CategorySlug) => (
								<a href={`/articles/category/${category}`} class="category-badge">
									{getCategoryName(category)}
								</a>
							))}
						</div>
					)
				}
				<dl class="meta">
					<dt class="visually-hidden">Posted at</dt>
					<dd>
						<time datetime={pubDate.toISOString()}>
							{
								pubDate.toLocaleDateString('en-GB', {
									day: 'numeric',
									month: 'long',
									year: 'numeric',
								})
							}
						</time>
					</dd>
					<dt class="visually-hidden">Posted By</dt>
					<dd>{author}</dd>
				</dl>
			</div>

			{
				thumbnail && (
					<div class="background-canvas">
						<Image src={thumbnail} loading="eager" alt={title} inferSize={true} />
					</div>
				)
			}
		</header>

		<div class="wrap">
			<div class="prose stack">
				<Content />
			</div>
		</div>
	</article>

	<NewsletterSignup />

	<TakeAction />
</Layout>
