---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TakeAction from '../../components/TakeAction.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import ArticleCategoryCta from '../../components/ArticleCategoryCta.astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import { getCategoryName } from '../../helpers';
import type { CategorySlug } from '../../helpers';

export async function getStaticPaths() {
	const articles = await getCollection('articles');

	return articles.map((article) => ({
		params: { slug: article.id.replace(/\.(md|mdx)$/i, '') },
	}));
}

const { slug } = Astro.params;
const articles = await getCollection('articles');
const article = articles.find((entry) => entry.id.replace(/\.(md|mdx)$/i, '') === slug);

if (!article) {
	return Astro.rewrite('/404');
}

const {
	data: { author, description, pubDate, title, thumbnail, thumbnailAttribution, categories },
} = article;
const { Content } = await render(article);

const categoryCtaTags: CategorySlug[] = [
	'woodland-creation',
	'woodland-management',
	'conservation-biodiversity',
	'community-volunteering',
];

const hasCategoryCta = (categories ?? []).some((category) => categoryCtaTags.includes(category));
---

<Layout
	{title}
	{description}
	breadcrumb={title}
	image={thumbnail}
	ogImagePath={`/og/articles/${slug}.webp`}
	type="article"
	{author}
	{pubDate}
>
	<!-- Hero Section -->
	<article class="post">
		<header>
			<div class="wrap">
				<h1>{title}</h1>
				{
					categories && categories.length > 0 && (
						<div class="categories">
							{categories.map((category: CategorySlug) => (
								<a href={`/articles/category/${category}`} class="category-badge">
									{getCategoryName(category)}
								</a>
							))}
						</div>
					)
				}
				<dl class="meta">
					<dt class="visually-hidden">Posted at</dt>
					<dd>
						<time datetime={pubDate.toISOString()}>
							{
								pubDate.toLocaleDateString('en-GB', {
									day: 'numeric',
									month: 'long',
									year: 'numeric',
								})
							}
						</time>
					</dd>
					<dt class="visually-hidden">Posted By</dt>
					<dd>{author}</dd>
				</dl>
				{
					thumbnailAttribution && (
						<p class="hero-image-attribution">
							Image:{' '}
							{thumbnailAttribution.url ? (
								<a href={thumbnailAttribution.url} target="_blank" rel="noreferrer">
									{thumbnailAttribution.text}
								</a>
							) : (
								thumbnailAttribution.text
							)}
							{thumbnailAttribution.license && <> · {thumbnailAttribution.license}</>}
						</p>
					)
				}
			</div>

			{
				thumbnail && (
					<div class="background-canvas">
						<Image src={thumbnail} loading="eager" alt={title} inferSize={true} />
					</div>
				)
			}
		</header>

		<div class="wrap">
			<div class="prose stack">
				<Content />
			</div>
		</div>
	</article>

	{hasCategoryCta ? <ArticleCategoryCta categories={categories} /> : <NewsletterSignup />}

	<TakeAction />
</Layout>
