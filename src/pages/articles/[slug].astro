---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TakeAction from '../../components/TakeAction.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import { render } from 'astro:content';

export async function getStaticPaths() {
	const articles = await getCollection('articles');

	return articles.map((article) => ({
		params: { slug: article.id },
		data: { article },
	}));
}

const { slug } = Astro.params;

const article = await getEntry('articles', slug);

if (!article) {
	return Astro.rewrite('/404');
}

const {
	data: { author, description, pubDate, title, thumbnail },
} = article;
const { Content } = await render(article);
---

<Layout {title} {description} breadcrumb={title}>
	<!-- Hero Section -->
	<article class="post">
		<header>
			<div class="wrap">
				<h1>{title}</h1>
				<dl class="meta">
					<dt class="visually-hidden">Posted at</dt>
					<dd>
						<time datetime={pubDate.toISOString()}>
							{
								pubDate.toLocaleDateString('en-GB', {
									day: 'numeric',
									month: 'long',
									year: 'numeric',
								})
							}
						</time>
					</dd>
					<dt class="visually-hidden">Posted By</dt>
					<dd>{author}</dd>
				</dl>
			</div>

			{
				thumbnail && (
					<div class="background-canvas">
						<Image src={thumbnail} loading="eager" alt={title} inferSize={true} />
					</div>
				)
			}
		</header>

		<div class="wrap">
			<div class="prose stack">
				<Content />
			</div>
		</div>
	</article>

	<NewsletterSignup />

	<TakeAction />
</Layout>
