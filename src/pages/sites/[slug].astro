---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { marked } from 'marked';
import ContentHero from '../../components/ContentHero.astro';
import ImageGallery from '../../components/ImageGallery.astro';
import SiteDetails from '../../components/SiteDetails.astro';
import TakeAction from '../../components/TakeAction.astro';
import { siteConfig } from '../../config';
import { fetchSites, toKebabCase } from '../../helpers';
import Layout from '../../layouts/Layout.astro';
import MapPin from '../../assets/icons/map-pin.svg';
import Tree from '../../assets/icons/tree-deciduous.svg';
import PenField from '../../assets/icons/pen-field.svg';
import Seedling from '../../assets/icons/seedling.svg';
import Chart from '../../assets/icons/chart-fft.svg';

export const prerender = true;

export async function getStaticPaths() {
	const allApiSites = await fetchSites();

	// Filter out ignored sites
	const apiSites = allApiSites.filter((site: any) => !siteConfig.ignoredSites.includes(site.name));

	const siteCollection = await getCollection('siteMeta');

	// Create a map of API data by kebab-case name
	const apiDataMap = new Map();
	apiSites.forEach((site: any) => {
		const slug = toKebabCase(site.name);
		apiDataMap.set(slug, { ...site, slug });
	});

	return siteCollection.map((site) => {
		const collectionApiData = apiDataMap.get(site.id);
		return {
			params: { slug: site.id },
			props: { site, apiData: collectionApiData },
		};
	});
}

const { site, apiData } = Astro.props;

// If site is not found, return 404
if (!site) {
	return Astro.redirect('/404');
}

// Fetch site updates for this site
const allSiteUpdates = await getCollection('siteUpdates');
const siteNotionIds = site.data.notionIds || [];
const siteUpdates = await Promise.all(
	allSiteUpdates
		.filter(
			(update) => update.data.siteNotionId && siteNotionIds.includes(update.data.siteNotionId),
		)
		.map((siteUpdate) => ({
			...siteUpdate,
			data: {
				...siteUpdate.data,
				date: siteUpdate.data.date ? new Date(siteUpdate.data.date) : undefined,
			},
		}))
		.sort((a, b) => {
			if (!a.data.date) return 1;
			if (!b.data.date) return -1;
			return b.data.date.getTime() - a.data.date.getTime();
		})
		.map(async (update) => ({
			...update,
			bodyHtml: update.body ? await marked.parse(update.body) : '',
		})),
);

const mapboxToken = import.meta.env.PUBLIC_MAPBOX_TOKEN;

// Use API data for main info, fallback to collection data
const siteName = apiData?.name || site.id;
const siteLocation = apiData?.location || '';
const coordinates = apiData?.coordinates;
const siteId = site.data.siteId;
const flagShowArea = site.data.flagShowArea;
// Use images directly from content collection
const images = site.data.images || [];
const heroImage = images[0] || null;
const fundingPartners = site.data.fundingPartners || [];
const siteDescription = apiData?.description;
const descriptionHtml = siteDescription ? await marked.parse(siteDescription) : '';
const species = apiData?.species || [];
const fundingSiteId = apiData?.id;

let siteMapGeoJson: any = null;
if (flagShowArea && siteId) {
	try {
		const mapResponse = await fetch(`https://api.protect.earth/maps/sites/${siteId}`);
		if (mapResponse.ok) {
			const mapData = await mapResponse.json();
			if (mapData?.type === 'FeatureCollection' && Array.isArray(mapData.features)) {
				const polygonFeatures = mapData.features.filter((feature: any) => {
					const geometryType = feature?.geometry?.type;
					return geometryType === 'Polygon' || geometryType === 'MultiPolygon';
				});

				if (polygonFeatures.length > 0) {
					siteMapGeoJson = {
						type: 'FeatureCollection',
						features: polygonFeatures,
					};
				}
			}
		}
	} catch (error) {
		console.warn(`Could not load map polygons for ${site.id}:`, (error as Error).message);
	}
}

const hasCoordinates = Boolean(coordinates && coordinates.latitude && coordinates.longitude);
const hasMapData = hasCoordinates || Boolean(siteMapGeoJson);

// Funding partner logo mapping
type FundingPartnerInfo = { src: string; alt: string; url: string };
const fundingPartnerLogos = {
	ecologi: {
		src: '/logos/funding/ecologi-logo.png',
		alt: 'Ecologi',
		url: 'https://ecologi.com/',
	},
	'woodland-trust': {
		src: '/logos/funding/woodland-trust-logo.png',
		alt: 'Woodland Trust',
		url: 'https://www.woodlandtrust.org.uk/',
	},
	reewild: {
		src: '/logos/funding/reewild-logo.png',
		alt: 'Reewild',
		url: 'https://www.reewild.co.uk/',
	},
	earthpoints: {
		src: '/logos/funding/earthpoints-logo.png',
		alt: 'Earthpoints',
		url: 'https://earthpoints.co.uk/',
	},
	'9trees': {
		src: '/logos/funding/9trees-logo.svg',
		alt: '9Trees CIC',
		url: 'https://9trees.org/',
	},
} as Record<string, FundingPartnerInfo>;

const fundingPartnerInfos = fundingPartners
	.map((partner) => fundingPartnerLogos[partner])
	.filter(Boolean);
---

<Layout title={siteName} description={siteLocation} image={heroImage || undefined} type="website">
	<!-- Hero Section -->
	<ContentHero imgAlt={`Landscape view of ${siteName}`} imgSrc={heroImage} title={siteName}>
		{
			siteLocation && (
				<p>
					<MapPin height={24} width={24} /> {siteLocation}
				</p>
			)
		}
	</ContentHero>

	<!-- Description -->
	<section class="page-sections wrap">
		{
			fundingPartnerInfos.length > 0 ? (
				<div class="intro">
					{descriptionHtml && (
						<div class="stack prose" data-readable-width="larger" set:html={descriptionHtml} />
					)}
					<div class="partnerships">
						<h3>In partnership with</h3>

						<div class="stack">
							{fundingPartnerInfos.map((partnerInfo) => (
								<a
									href={partnerInfo.url}
									target="_blank"
									rel="noopener noreferrer"
									class="squircle"
								>
									<img src={partnerInfo.src} alt={partnerInfo.alt} />
								</a>
							))}
						</div>
					</div>
				</div>
			) : (
				<div class="intro">
					{descriptionHtml && (
						<div class="stack prose" data-readable-width="larger" set:html={descriptionHtml} />
					)}
				</div>
			)
		}
	</section>

	<!-- Image Gallery -->
	<section class="page-sections wrap">
		<ImageGallery images={images} siteName={siteName} />
	</section>

	<!-- Site Details: work stats + funding, fetched once to avoid duplicate site requests -->
	<section class="page-sections wrap">
		{
			fundingSiteId && (
				<SiteDetails server:defer siteId={fundingSiteId}>
					<section slot="fallback" class="funding-skeleton" aria-busy="true">
						<header>
							<h2>Help fund our work</h2>
							<p>Fund the work still needed to complete this critical work.</p>
						</header>

						<ul>
							{Array.from({ length: 2 }, () => (
								<li aria-hidden="true">
									<span />
									<span />
									<span />
								</li>
							))}
						</ul>
					</section>
				</SiteDetails>
			)
		}
	</section>

	<section class="page-sections wrap">
		<!-- Site Updates Section -->
		{
			siteUpdates.length > 0 && (
				<section class="updates">
					<header>
						<h2>
							<PenField height={36} width={36} />
							Updates
						</h2>
					</header>

					<div class="updates-articles">
						{siteUpdates.map(({ data, bodyHtml }) => (
							<article class="update">
								<header>
									<h3>
										{data.date && (
											<time datetime={data.date.toISOString()}>
												{data.date.toLocaleDateString('en-GB', {
													year: 'numeric',
													month: 'long',
												})}
											</time>
										)}
									</h3>
								</header>

								<ul class="meta tags">
									{data.type && (
										<li class="tag" data-type="type">
											{data.type}
										</li>
									)}
									{data.treesPlanted && (
										<li class="tag" data-type="planted">
											<Tree height={18} width={18} /> {data.treesPlanted.toLocaleString()}
											trees planted
										</li>
									)}
									{data.treesRestocked && (
										<li class="tag" data-type="restocked">
											<Seedling height={18} width={18} /> {data.treesRestocked.toLocaleString()}
											trees restocked
										</li>
									)}
									{data.survivalRate != null && (
										<li class="tag" data-type="survival-rate">
											<Chart height={18} width={18} />
											{(data.survivalRate * 100).toFixed(0)}% survival rate
										</li>
									)}
								</ul>

								{bodyHtml && <div class="stack prose" set:html={bodyHtml} />}

								{data.photos && data.photos.length > 0 && (
									<div class="grid image-gallery">
										{data.photos.map((photo: any) => (
											<a href={photo.src} target="_blank" rel="noopener noreferrer" class="block">
												<Image
													src={photo}
													alt={`Site update photo for ${siteName}`}
													loading="lazy"
												/>
											</a>
										))}
									</div>
								)}
							</article>
						))}
					</div>
				</section>
			)
		}

		<!-- Species Section -->
		{
			species.length > 0 && (
				<section class="trees">
					<h2>
						<Tree height={36} width={36} /> Species Planted
					</h2>
					<ul class="grid">
						{species.map((sp: any) => (
							<li>
								<span>{sp.name}</span>
							</li>
						))}
					</ul>
				</section>
			)
		}
		<!-- Map Section -->
		{
			hasMapData && (
				<section>
					<h2>
						<MapPin height={36} width={36} /> Site Location
					</h2>
					<div id="map" class="map-canvas" />
				</section>
			)
		}
	</section>

	<TakeAction />
</Layout>

<style>
	h2 {
		font-size: var(--font-xl);
		margin-block-end: var(--space-s);
	}

	h3 {
		font-size: var(--font-m);
		margin-block-end: var(--space-s);
	}

	.partnerships img {
		max-inline-size: 300px;
	}

	/* This page stacks several .page-sections blocks; collapse the repeated padding between them */
	.page-sections + .page-sections {
		padding-block-start: 0;
	}

	.intro {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: start;
		gap: var(--space-2xl);
	}

	@media screen and (max-width: 700px) {
		.intro {
			grid-template-columns: 1fr;
		}
	}
	.updates-articles {
		display: flex;
		flex-flow: column;
		gap: var(--space-xl);
	}

	.update {
		background: var(--white);
		padding: var(--space-m);
		border-radius: var(--radius-m);
		box-shadow: var(--shadow-lite);
	}

	.update:has(.image-gallery) .prose {
		margin-block-end: var(--space-m);
	}

	.trees ul {
		font-size: var(--font-m);
		grid-template-columns: var(--grid-fill);
	}

	.trees li {
		border: 2px solid var(--border-color);
		padding: var(--space-2xs);
		border-radius: var(--radius-s);
	}

	.meta {
		margin-block-end: var(--space-m);
	}

	.update h3 {
		font-size: var(--font-xl);
		margin-block-end: var(--space-s);
	}

	.image-gallery {
		grid-template-columns: var(--grid-fit-12rem);
	}

	.image-gallery a {
		max-inline-size: 100%;
		block-size: 100%;
	}

	.image-gallery img {
		border-radius: var(--radius-s);
		inset: 0;
		object-fit: cover;
		max-inline-size: 100%;
		block-size: 100%;
	}

	.funding-skeleton {
		background: var(--white);
		padding: var(--space-l);
		border-radius: var(--radius-m);
		box-shadow: var(--shadow-lite);
	}

	.funding-skeleton header {
		max-inline-size: var(--measure);
		margin-block-end: var(--space-m);
	}

	.funding-skeleton ul {
		display: grid;
		gap: var(--space-m);
	}

	.funding-skeleton li {
		display: grid;
		gap: var(--space-2xs);
		grid-template-columns: 1fr auto;
		min-block-size: 6rem;
	}

	.funding-skeleton span {
		background: var(--grey-light);
		border-radius: var(--radius-xs);
		animation: funding-placeholder 1.5s ease-in-out infinite;
	}

	.funding-skeleton span:first-child {
		inline-size: 45%;
		block-size: 1.5rem;
	}

	.funding-skeleton span:nth-child(2) {
		grid-column: 1 / -1;
		block-size: var(--space-s);
	}

	.funding-skeleton span:last-child {
		inline-size: 60%;
		block-size: 1.25rem;
	}

	@media screen and (max-width: 600px) {
		.funding-skeleton {
			padding: var(--space-m);
		}
	}

	@keyframes funding-placeholder {
		50% {
			opacity: 0.5;
		}
	}
</style>

<!-- Mapbox GL JS -->
<link href="https://api.mapbox.com/mapbox-gl-js/v2.8.2/mapbox-gl.css" rel="stylesheet" />
<script src="https://api.mapbox.com/mapbox-gl-js/v2.8.2/mapbox-gl.js"></script>

<script is:inline define:vars={{ coordinates, siteName, mapboxToken, siteMapGeoJson }}>
	if ((coordinates && coordinates.latitude && coordinates.longitude) || siteMapGeoJson) {
		document.addEventListener('DOMContentLoaded', () => {
			mapboxgl.accessToken = mapboxToken;

			const defaultCenter = coordinates
				? [coordinates.longitude, coordinates.latitude]
				: [-2.5, 54.0];

			const map = new mapboxgl.Map({
				container: 'map',
				style: 'mapbox://styles/mapbox/satellite-v9',
				center: defaultCenter,
				zoom: 15,
			});

			map.addControl(new mapboxgl.NavigationControl());

			map.on('load', () => {
				const hasPolygonFeatures =
					siteMapGeoJson &&
					siteMapGeoJson.type === 'FeatureCollection' &&
					Array.isArray(siteMapGeoJson.features) &&
					siteMapGeoJson.features.length > 0;

				if (hasPolygonFeatures) {
					map.addSource('site-boundary', {
						type: 'geojson',
						data: siteMapGeoJson,
					});

					// No fill for now
					// map.addLayer({
					// 	id: 'site-boundary-fill',
					// 	type: 'fill',
					// 	source: 'site-boundary',
					// 	paint: {
					// 		'fill-color': '#166534',
					// 		'fill-opacity': 0.3,
					// 	},
					// });

					map.addLayer({
						id: 'site-boundary-line',
						type: 'line',
						source: 'site-boundary',
						paint: {
							'line-color': '#4400a9',
							'line-width': 2,
						},
					});

					const bounds = new mapboxgl.LngLatBounds();
					siteMapGeoJson.features.forEach((feature) => {
						const geometry = feature?.geometry;
						if (!geometry?.coordinates) return;

						if (geometry.type === 'Polygon') {
							geometry.coordinates.flat().forEach((coordinate) => bounds.extend(coordinate));
						}

						if (geometry.type === 'MultiPolygon') {
							geometry.coordinates.flat(2).forEach((coordinate) => bounds.extend(coordinate));
						}
					});

					if (!bounds.isEmpty()) {
						map.fitBounds(bounds, { padding: 40, maxZoom: 16 });
					}
				} else if (coordinates && coordinates.latitude && coordinates.longitude) {
					new mapboxgl.Marker({ color: '#15803d' })
						.setLngLat([coordinates.longitude, coordinates.latitude])
						.addTo(map);
				}
			});
		});
	}
</script>
