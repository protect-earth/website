---
import { getCollection } from 'astro:content';
import type { GetStaticPaths, Page } from 'astro';
import Layout from '../../layouts/Layout.astro';
import EventSummary from '../../components/EventSummary.astro';
import Pagination from '../../components/Pagination.astro';
import TakeAction from '../../components/TakeAction.astro';
import ContentHero from '../../components/ContentHero.astro';
import VolunteerSignup from '../../components/VolunteerSignup.astro';
import eventHero from '../../assets/pages/events/hero.jpg';

export const getStaticPaths = (async ({ paginate }) => {
	const events = (await getCollection('events'))
		.sort((a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf())
		.map((post) => ({ slug: post.id, data: post.data }));

	return paginate(events, { pageSize: 20 });
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page };
---

<Layout title="Events" breadcrumb={page.currentPage > 1 ? `Page ${page.currentPage}` : ''}>
	<ContentHero title="Events" imgSrc={eventHero} imgAlt="Path through High Wood, Liskeard">
		<p>
			Join us at one of our upcoming events. From tree planting to invasive species removal, there's
			something for everyone.
		</p>
	</ContentHero>

	<!-- Events List -->
	<section class="page-sections wrap">
		<div class="events-list">
			{page.data.map(({ slug, data: article }) => <EventSummary {...{ ...article, slug }} />)}
		</div>
		<!-- Pagination Controls -->
		{page.lastPage > 1 && <Pagination {...page} />}
	</section>

	<VolunteerSignup />

	<TakeAction />
</Layout>

<style>
	.events-list {
		display: flex;
		flex-flow: column;
		gap: var(--space-xl);
		align-items: flex-start;
	}
</style>
