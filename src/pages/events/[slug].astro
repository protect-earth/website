---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TakeAction from '../../components/TakeAction.astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
	const events = await getCollection('events');

	return events.map((event) => ({
		params: { slug: event.id },
		props: { event },
	}));
}
const { event } = Astro.props as { event: CollectionEntry<'events'> };

const {
	data: {
		address,
		description,
		endDate,
		eventbriteLink,
		googleCal,
		ics,
		images,
		map,
		startDate,
		title,
		thumbnail,
	},
} = event;
const customCta = (event.data as { customCta?: string }).customCta;
const startDateValue = startDate as Date | undefined;
const endDateValue = endDate as Date | undefined;
const isSingleDayEvent =
	startDateValue &&
	endDateValue &&
	startDateValue.getUTCFullYear() === endDateValue.getUTCFullYear() &&
	startDateValue.getUTCMonth() === endDateValue.getUTCMonth() &&
	startDateValue.getUTCDate() === endDateValue.getUTCDate();
const { Content } = await render(event);
---

<Layout {title} {description} breadcrumb={title} image={thumbnail}>
	<!-- Hero Section -->
	<div class="post">
		<header>
			<div class="wrap">
				<h1>{title}</h1>
				<dl class="meta">
					{
						isSingleDayEvent ? (
							<>
								<dt>Date</dt>
								<dd>
									<time datetime={startDateValue.toISOString()}>
										{startDateValue.toLocaleDateString('en-GB', {
											day: 'numeric',
											month: 'long',
											year: 'numeric',
										})}
									</time>
								</dd>
							</>
						) : (
							<>
								{
									startDateValue && (
										<>
											<dt>Starts</dt>
											<dd>
												<time datetime={startDateValue.toISOString()}>
													{startDateValue.toLocaleDateString('en-GB', {
														day: 'numeric',
														month: 'long',
														year: 'numeric',
													})}
												</time>
											</dd>
										</>
									)
								}
								{
									endDateValue && (
										<>
											<dt>Ends</dt>
											<dd>
												<time datetime={endDateValue.toISOString()}>
													{endDateValue.toLocaleDateString('en-GB', {
														day: 'numeric',
														month: 'long',
														year: 'numeric',
													})}
												</time>
											</dd>
										</>
									)
								}
							</>
						)
					}
					<dt>Time</dt>
					<dd>
						{
							startDateValue && (
								<time>
									{startDateValue.toLocaleTimeString('en-GB', {
										hour: '2-digit',
										minute: '2-digit',
									})}
								</time>
							)
						}
						{startDateValue && endDateValue && <>&mdash;</>}
						{
							endDateValue && (
								<time>
									{endDateValue.toLocaleTimeString('en-GB', {
										hour: '2-digit',
										minute: '2-digit',
									})}
								</time>
							)
						}
					</dd>
					{
						address && (
							<>
								<dt>Address</dt>
								<dd>
									{address}
									{map && (
										<>
											<br />
											<a href={map}>(Map)</a>
										</>
									)}
									{address && address !== 'Online event' && (
										<>
											<br />
											Full address will be provided after signup.
										</>
									)}
								</dd>
							</>
						)
					}
					{
						ics && googleCal && (
							<>
								<dt>Add to</dt>
								<dd>
									{ics && (
										<a href={ics} class="cal-link">
											iCal
										</a>
									)}
									or
									{googleCal && (
										<a href={googleCal} class="cal-link">
											Google Calendar
										</a>
									)}
								</dd>
							</>
						)
					}
				</dl>
			</div>

			{
				thumbnail && (
					<div class="background-canvas">
						<Image src={thumbnail} loading="eager" alt={title} inferSize={true} />
					</div>
				)
			}
		</header>

		<div class="wrap">
			<div class="prose stack">
				{
					images &&
						images.length > 0 && (
							<div class="event-imagegroup">
								{images.map((image, index) => (
									<Image
										src={image}
										loading="lazy"
										alt=""
									/>
								))}
							</div>
						)
				}

				<Content />

				{
					eventbriteLink && (
						<div class="event-cta">
							<a href={eventbriteLink} class="button" target="_blank" rel="noopener noreferrer">
									{customCta || 'Sign up to volunteer'}
							</a>
						</div>
					)
				}
			</div>

		</div>
	</div>

	<TakeAction />

</Layout>

<style>
	header {
		background: var(--green-dark);
	}

	.meta {
		display: grid;
		grid-template-columns: min-content 1fr;
		gap: var(--space-2xs);
	}

	.event-cta {
		display: grid;
		place-content: center;
	}
</style>
