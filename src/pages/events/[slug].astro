---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TakeAction from '../../components/TakeAction.astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import { siteConfig } from '../../config';

export async function getStaticPaths() {
	const events = await getCollection('events');

	return events.map((event) => ({
		params: { slug: event.id },
		props: { event },
	}));
}
const { event } = Astro.props as { event: CollectionEntry<'events'> };

const {
	data: {
		address,
		coordinates,
		description,
		endDate,
		eventbriteLink,
		images,
		startDate,
		title,
		thumbnail,
	},
} = event;
const eventTimezone = siteConfig.timezone;
const customCta = (event.data as { customCta?: string }).customCta;
const mapboxToken = import.meta.env.PUBLIC_MAPBOX_TOKEN;
const startDateValue = startDate as Date | undefined;
const endDateValue = endDate as Date | undefined;
const coordinatesValue =
	Array.isArray(coordinates) && coordinates.length === 2 ? coordinates : null;
const showMapPreview = Boolean(
	coordinatesValue && mapboxToken && address && address !== 'Online event',
);
const isSingleDayEvent =
	startDateValue &&
	endDateValue &&
	startDateValue.getUTCFullYear() === endDateValue.getUTCFullYear() &&
	startDateValue.getUTCMonth() === endDateValue.getUTCMonth() &&
	startDateValue.getUTCDate() === endDateValue.getUTCDate();
const { Content } = await render(event);
---

<Layout {title} {description} breadcrumb={title} image={thumbnail}>
	<!-- Hero Section -->
	<div class="post">
		<header>
			<div class="wrap">
				<h1>{title}</h1>
				<div class="event-header-columns">
					<dl class="meta">
						{
							isSingleDayEvent ? (
								<>
									<dt>Date</dt>
									<dd>
										<time datetime={startDateValue.toISOString()}>
											{startDateValue.toLocaleDateString('en-GB', {
												day: 'numeric',
												month: 'long',
												year: 'numeric',
												timeZone: eventTimezone,
											})}
										</time>
									</dd>
								</>
							) : (
								<>
									{startDateValue && (
										<>
											<dt>Starts</dt>
											<dd>
												<time datetime={startDateValue.toISOString()}>
													{startDateValue.toLocaleDateString('en-GB', {
														day: 'numeric',
														month: 'long',
														year: 'numeric',
														timeZone: eventTimezone,
													})}
												</time>
											</dd>
										</>
									)}
									{endDateValue && (
										<>
											<dt>Ends</dt>
											<dd>
												<time datetime={endDateValue.toISOString()}>
													{endDateValue.toLocaleDateString('en-GB', {
														day: 'numeric',
														month: 'long',
														year: 'numeric',
														timeZone: eventTimezone,
													})}
												</time>
											</dd>
										</>
									)}
								</>
							)
						}
						<dt>Time</dt>
						<dd>
							{
								startDateValue && (
									<time>
										{startDateValue.toLocaleTimeString('en-GB', {
											hour: '2-digit',
											minute: '2-digit',
											timeZone: eventTimezone,
										})}
									</time>
								)
							}
							{startDateValue && endDateValue && <>&mdash;</>}
							{
								endDateValue && (
									<time>
										{endDateValue.toLocaleTimeString('en-GB', {
											hour: '2-digit',
											minute: '2-digit',
											timeZone: eventTimezone,
										})}
									</time>
								)
							}
						</dd>
						{
							address && (
								<>
									<dt>Where</dt>
									<dd>
										{address}
										{address && address !== 'Online event' && (
											<>
												{' '}
												<span
													class="tooltip-trigger"
													role="button"
													tabindex="0"
													title="Full address will be provided after signup"
													aria-label="Full address will be provided after signup"
													data-tooltip="Full address will be provided after signup"
												>
													i
												</span>
											</>
										)}
									</dd>
								</>
							)
						}
					</dl>
					{
						showMapPreview && (
							<aside class="event-map-preview" aria-label="Approximate event location map">
								<div id="event-map" class="event-map-canvas" />
								<p class="event-map-caption">Approximate location</p>
							</aside>
						)
					}
				</div>
			</div>

			{
				thumbnail && (
					<div class="background-canvas">
						<Image src={thumbnail} loading="eager" alt={title} inferSize={true} />
					</div>
				)
			}
		</header>

		<div class="wrap">
			<div class="prose stack">
				{
					images && images.length > 0 && (
						<div class="event-imagegroup">
							{images.map((image, index) => (
								<Image src={image} loading="lazy" alt="" />
							))}
						</div>
					)
				}

				<Content />

				{
					eventbriteLink && (
						<div class="event-cta">
							<a href={eventbriteLink} class="button" target="_blank" rel="noopener noreferrer">
								{customCta || 'Sign up to volunteer'}
							</a>
						</div>
					)
				}
			</div>
		</div>
	</div>

	<TakeAction />
</Layout>

<style>
	header {
		background: var(--green-dark);
	}

	.meta {
		display: grid;
		grid-template-columns: min-content 1fr;
		gap: var(--space-2xs);
	}

	.event-cta {
		display: grid;
		place-content: center;
	}

	.tooltip-trigger {
		display: inline-grid;
		place-items: center;
		inline-size: 1.1rem;
		block-size: 1.1rem;
		font-size: 0.75rem;
		font-weight: 700;
		line-height: 1;
		border: 1px solid currentColor;
		border-radius: 999px;
		cursor: help;
		position: relative;
		vertical-align: middle;
	}

	.tooltip-trigger::after {
		content: attr(data-tooltip);
		position: absolute;
		left: 50%;
		bottom: calc(100% + 0.4rem);
		transform: translateX(-50%);
		min-inline-size: 14rem;
		max-inline-size: 18rem;
		padding: 0.45rem 0.55rem;
		border-radius: 0.35rem;
		background: var(--green-dark);
		color: var(--white);
		font-size: 0.75rem;
		line-height: 1.3;
		text-align: left;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.15s ease;
		z-index: 5;
	}

	.tooltip-trigger:hover::after,
	.tooltip-trigger:focus-visible::after {
		opacity: 1;
	}

	.event-header-columns {
		display: grid;
		gap: var(--space-m);
		align-items: stretch;
	}

	.meta,
	.event-map-preview {
		padding: var(--space-s);
		border-radius: var(--radius-s);
	}

	.event-map-preview {
		display: grid;
		gap: var(--space-3xs);
	}

	.event-map-canvas {
		inline-size: 100%;
		min-block-size: 200px;
		border-radius: var(--radius-s);
		overflow: hidden;
		box-shadow: var(--shadow-lite);
	}

	.event-map-caption {
		font-size: var(--font-2xs);
		opacity: 0.9;
	}

	@media (min-width: 48rem) {
		.event-header-columns {
			grid-template-columns: minmax(260px, 1fr) minmax(240px, 300px);
		}
	}
</style>

<link href="https://api.mapbox.com/mapbox-gl-js/v3.5.2/mapbox-gl.css" rel="stylesheet" />
<script src="https://api.mapbox.com/mapbox-gl-js/v3.5.2/mapbox-gl.js"></script>
<script is:inline define:vars={{ mapCoordinates: coordinatesValue, mapboxToken, title }}>
	if (mapCoordinates && mapboxToken) {
		document.addEventListener('DOMContentLoaded', () => {
			mapboxgl.accessToken = mapboxToken;

			const map = new mapboxgl.Map({
				container: 'event-map',
				style: 'mapbox://styles/mapbox/standard',
				center: mapCoordinates,
				zoom: 8,
				attributionControl: false,
			});

			map.addControl(new mapboxgl.NavigationControl());

			new mapboxgl.Marker({ color: '#15803d' })
				.setLngLat(mapCoordinates)
				.setPopup(new mapboxgl.Popup({ offset: 20 }).setText(title))
				.addTo(map);
		});
	}
</script>
