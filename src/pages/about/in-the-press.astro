---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ContentHero from '../../components/ContentHero.astro';
import PressArticle from '../../components/PressArticle.astro';
import TakeAction from '../../components/TakeAction.astro';
import { heroPress } from '../../assets/hero-images';

const [pressArticles] = await getCollection('press');
const articles = pressArticles.data ?? [];
---

<Layout title="In the Press">
	<!-- Hero Section with Background Image -->
	<ContentHero imgSrc={heroPress} imgAlt="Forest path through pine trees" title="In the Press">
		<p>Coverage of Protect Earth's mission to rewild Britain and protect our natural heritage</p>
	</ContentHero>

	<!-- Press Articles Grid -->
	<section class="page-sections wrap">
		<div class="press-articles grid">
			{articles.map((article) => <PressArticle {...article} />)}
		</div>
	</section>

	<TakeAction />
</Layout>

<style>
	.grid {
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
	}
</style>
