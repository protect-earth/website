---
import { siteConfig } from '../config';
---

<section class="achievements wrap">
	<h2>Our Achievements</h2>
	<div class="grid">
		<div class="stat stat-trees squircle">
			<h3>
				{siteConfig.achievements.treesPlanted}
			</h3>
			<span>Trees planted</span>
		</div>
		<div class="stat stat-hedgerows squircle">
			<h3>
				{siteConfig.achievements.hedgerowsMeters}
			</h3>
			<span>Hedgerows planted (meters)</span>
		</div>
		<div class="stat stat-volunteer squircle">
			<h3>
				{siteConfig.achievements.volunteerHours}
			</h3>
			<span>Volunteer hours</span>
		</div>
		<div class="stat stat-survival squircle">
			<h3>
				{siteConfig.achievements.survivalRate}
			</h3>
			<span>Survival rate (%) as of summer 2025</span>
		</div>
		<div class="stat stat-restored squircle">
			<h3>
				{siteConfig.achievements.acresRestored}
			</h3>
			<span>Acres restored</span>
		</div>
		<div class="stat stat-management squircle">
			<h3>
				{siteConfig.achievements.acresUnderManagement}
			</h3>
			<span>Acres under direct management</span>
		</div>
	</div>
</section>

<style>
	section h2 {
		font-size: var(--font-2xl);
		text-align: center;
		margin-block-end: var(--space-xl);
	}

	section {
		padding-block: var(--space-xl);
	}

	.stat {
		padding: var(--space-m);
		background: var(--stat);
		color: var(--body-text-light);
	}

	.stat h3 {
		font-size: var(--font-3xl);
		margin-block-end: var(--space-2xs);
	}

	.stat span {
		font-size: var(--font-xs);
	}
</style>

<script>
	import { gsap } from 'gsap';
	import { TextPlugin } from 'gsap/TextPlugin';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	gsap.registerPlugin(ScrollTrigger, TextPlugin);

	document.addEventListener('DOMContentLoaded', () => {
		const counters = [
			['.stat-trees h3'],
			['.stat-survival h3', '%'],
			['.stat-hedgerows h3'],
			['.stat-restored h3'],
			['.stat-management h3'],
			['.stat-volunteer h3'],
		] as const;

		const timeline = gsap.timeline({
			paused: true,
			defaults: { duration: 3, textContent: 0 },
			scrollTrigger: {
				trigger: '.achievements',
				start: 'top 75% bottom',
				end: 'bottom 5% bottom',
				toggleActions: 'play pause resume reset',
			},
		});

		for (const [selector, suffix] of counters) {
			const counter = document.querySelector(selector) as HTMLElement;

			timeline.from(
				counter,
				{
					snap: { textContent: 1 },
					...{
						onUpdate: () => {
							counter.textContent =
								parseInt(counter.textContent).toLocaleString('en-GB') + (suffix || '');
						},
					},
				},
				0,
			);
		}
	});
</script>
