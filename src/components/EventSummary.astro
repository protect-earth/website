---
import { isSameDay } from '../helpers';
import type { HTMLTag, Polymorphic } from 'astro/types';
import { Image } from 'astro:assets';
import NoImage from './../assets/icons/image.svg';

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }>;
const {
	description,
	startDate,
	endDate,
	slug,
	address,
	thumbnail,
	title,
	titleAs: Tag = 'h2',
} = Astro.props;
---

<article class="card">
	<div class="stack">
		<Tag>{title}</Tag>

		{description && <p>{description}</p>}

		<ul class="meta">
			{
				isSameDay(startDate, endDate) ? (
					<li>
						<time datetime={startDate.toISOString()}>
							{startDate.toLocaleString('en-GB', {
								day: 'numeric',
								month: 'long',
								year: 'numeric',
							})}
						</time>
					</li>
				) : (
					<li>
						<time datetime={startDate.toISOString()}>
							{startDate.toLocaleString('en-GB', {
								day: 'numeric',
								month: 'long',
								year: 'numeric',
							})}
						</time>
						&mdash;
						<time datetime={endDate.toISOString()}>
							{endDate.toLocaleString('en-GB', {
								day: 'numeric',
								month: 'long',
								year: 'numeric',
							})}
						</time>
					</li>
				)
			}
			<li>
				{
					startDate && (
						<time>
							{startDate.toLocaleTimeString('en-GB', {
								hour: '2-digit',
								minute: '2-digit',
							})}
						</time>
					)
				}
				{startDate && endDate && <>&mdash;</>}
				{
					endDate && (
						<time>
							{endDate.toLocaleTimeString('en-GB', {
								hour: '2-digit',
								minute: '2-digit',
							})}
						</time>
					)
				}
			</li>
			<li>
				{address}
			</li>
		</ul>

		<a class="button" href={`/events/${slug}`}>View event</a>
	</div>

	<figure>
		<a href={`/events/${slug}`}>
			{
				thumbnail ? (
					<Image
						src={thumbnail}
						alt={title}
						width={600}
						height={400}
						loading="lazy"
						class="squircle"
					/>
				) : (
					<div class="no-image">
						<NoImage height={36} width={36} />
					</div>
				)
			}
		</a>
	</figure>
</article>

<style>
	.card {
		display: flex;
		flex-flow: row-reverse;
		justify-content: flex-start;
		gap: var(--space-m);

		@media screen and (max-width: 844px) {
			flex-flow: column-reverse;
		}
	}

	.stack {
		flex: 3;
	}

	.button {
		align-self: flex-start;
	}

	figure {
		aspect-ratio: 3/2;
		overflow: hidden;
		max-inline-size: 28rem;
		transition: all var(--transition);
		@media screen and (max-width: 844px) {
			max-inline-size: 100%;
		}
	}

	figure:hover {
		transform: scale(102%);
		filter: var(--hover-effect-filter);
	}
</style>
