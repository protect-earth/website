---
interface Props {
	title?: string;
	intro?: string;
	privacyPrefix?: string;
	privacySuffix?: string;
	site: string;
	workPartiesLabel?: string;
	generalUpdatesLabel?: string;
}

const {
	title = 'Stay up to date',
	intro = "Join our mailing list to keep up with what's happening at this site.",
	privacyPrefix = "We don't email too often and you can unsubscribe any time. Your ",
	privacySuffix = ' and your info will not be passed to third parties.',
	site,
	workPartiesLabel = 'Would you like to know about work parties?',
	generalUpdatesLabel = 'Would you like to receive general updates from work Protect Earth is doing elsewhere?',
} = Astro.props;
---

<section class="wrap">
	<h2>{title}</h2>

	<form class="SiteSignup__form squircle stack">
		<p>{intro}</p>

		<p>
			{privacyPrefix}<a href="/privacy-policy">privacy is important to us</a>{privacySuffix}
		</p>

		<p style="display: none;">
			<label>Do not fill this in: <input name="honeyTrap" /></label>
			<input type="hidden" name="site" value={site} />
		</p>

		<fieldset>
			<legend class="visually-hidden">Your details</legend>
			<div class="inline-group">
				<div>
					<label for="site-signup-first-name" class="visually-hidden">First Name</label>
					<input
						type="text"
						id="site-signup-first-name"
						name="firstName"
						placeholder="First Name"
						required
					/>
				</div>
				<div>
					<label for="site-signup-last-name" class="visually-hidden">Last Name</label>
					<input type="text" id="site-signup-last-name" name="lastName" placeholder="Last Name" />
				</div>
			</div>
			<div>
				<label for="site-signup-email" class="visually-hidden">Email</label>
				<input
					type="email"
					id="site-signup-email"
					name="email"
					placeholder="Email address"
					required
				/>
			</div>
		</fieldset>

		<fieldset class="checkbox-group">
			<legend>What would you like to hear about?</legend>
			<label class="checkbox-option">
				<input type="checkbox" name="workParties" />
				<span>{workPartiesLabel}</span>
			</label>
			<label class="checkbox-option">
				<input type="checkbox" name="generalUpdates" />
				<span>{generalUpdatesLabel}</span>
			</label>
		</fieldset>

		<button type="submit" class="button">Subscribe</button>

		<div class="form-message" data-message-container aria-live="assertive"></div>
	</form>
</section>

<script>
	document.querySelectorAll('.SiteSignup__form').forEach((form) => {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const formEl = e.currentTarget as HTMLFormElement;
			const button = formEl.querySelector('button[type="submit"]') as HTMLButtonElement;
			const messageDiv = formEl.querySelector('[data-message-container]') as HTMLElement;

			button.disabled = true;
			button.textContent = 'Subscribing...';
			messageDiv.removeAttribute('data-status');

			const formData = new FormData(formEl);

			try {
				const response = await fetch('/api/subscribe', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						email: formData.get('email'),
						firstName: formData.get('firstName'),
						lastName: formData.get('lastName'),
						honeyTrap: formData.get('honeyTrap'),
						site: formData.get('site'),
						workParties: formData.get('workParties') === 'on',
						generalUpdates: formData.get('generalUpdates') === 'on',
					}),
				});

				const result = await response.json();

				messageDiv.textContent = result.message;
				messageDiv.setAttribute('data-status', result.success ? 'success' : 'error');

				if (result.success) formEl.reset();
			} catch {
				messageDiv.textContent = 'Something went wrong. Please try again.';
				messageDiv.setAttribute('data-status', 'error');
			} finally {
				button.disabled = false;
				button.textContent = 'Subscribe';
			}
		});
	});
</script>

<style>
	section h2 {
		font-size: var(--font-2xl);
		text-align: center;
		margin-block-end: var(--space-xl);
	}

	section {
		padding-block-end: var(--space-xl);
	}

	p {
		font-size: var(--font-s);
	}

	form {
		background: var(--white);
		max-width: 44rem;
		margin: auto;
		align-items: unset;
	}

	fieldset {
		display: flex;
		flex-flow: column;
		gap: var(--space-s);
		font-size: var(--font-s);
	}

	fieldset > * + * {
		margin: 0;
	}

	.inline-group {
		display: flex;
		gap: var(--space-s);
		@media screen and (max-width: 540px) {
			flex-flow: column;
		}
	}

	.inline-group div {
		flex: 1;
	}

	.checkbox-group {
		gap: var(--space-2xs);
	}

	.checkbox-option {
		display: flex;
		align-items: flex-start;
		gap: var(--space-2xs);
		font-size: var(--font-s);
	}

	.checkbox-option input {
		margin-top: 0.2rem;
	}
</style>
