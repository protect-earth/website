---
interface Props {
	title?: string;
	intro?: string;
	privacyPrefix?: string;
	privacySuffix?: string;
}

const {
	title = 'Stay up to date',
	intro = "Join our mailing list to keep up with what we're doing to restore natural habitats and boost biodiversity across the UK.",
	privacyPrefix = "We don't email too often and you can unsubscribe any time. Your ",
	privacySuffix = ' and your info will not be passed to third parties.',
} = Astro.props;
---

<section class="wrap">
	<h2>{title}</h2>

	<form class="NewsletterSignup__form squircle stack">
		<p>{intro}</p>

		<p>
			{privacyPrefix}<a href="/privacy-policy">privacy is important to us</a>{privacySuffix}
		</p>

		<p style="display: none;">
			<label>Do not fill this in: <input name="honeyTrap" /></label>
		</p>

		<fieldset>
			<legend class="visually-hidden">Your details</legend>
			<div class="inline-group">
				<div>
					<label for="newsletter-first-name" class="visually-hidden">First Name</label>
					<input
						type="text"
						id="newsletter-first-name"
						name="firstName"
						placeholder="First Name"
						required
					/>
				</div>
				<div>
					<label for="newsletter-last-name" class="visually-hidden">Last Name</label>
					<input type="text" id="newsletter-last-name" name="lastName" placeholder="Last Name" />
				</div>
			</div>
		</fieldset>
		<fieldset>
			<div>
				<label for="newsletter-email" class="visually-hidden">Email</label>
				<input
					type="email"
					id="newsletter-email"
					name="email"
					placeholder="Email address"
					required
				/>
			</div>
		</fieldset>

		<button type="submit" class="button">Subscribe</button>

		<div class="form-message" data-message-container aria-live="assertive"></div>
	</form>
</section>

<script>
	document.querySelectorAll('.NewsletterSignup__form').forEach((form) => {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const formEl = e.currentTarget as HTMLFormElement;
			const button = formEl.querySelector('button[type="submit"]') as HTMLButtonElement;
			const messageDiv = formEl.querySelector('[data-message-container]') as HTMLElement;

			button.disabled = true;
			button.textContent = 'Subscribing...';
			messageDiv.removeAttribute('data-status');

			const formData = new FormData(formEl);

			try {
				const response = await fetch('/api/subscribe', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						email: formData.get('email'),
						firstName: formData.get('firstName'),
						lastName: formData.get('lastName'),
						honeyTrap: formData.get('honeyTrap'),
						list: 'general',
					}),
				});

				const result = await response.json();

				messageDiv.textContent = result.message;
				messageDiv.setAttribute('data-status', result.success ? 'success' : 'error');

				if (result.success) formEl.reset();
			} catch {
				messageDiv.textContent = 'Something went wrong. Please try again.';
				messageDiv.setAttribute('data-status', 'error');
			} finally {
				button.disabled = false;
				button.textContent = 'Subscribe';
			}
		});
	});
</script>

<style>
	section h2 {
		font-size: var(--font-2xl);
		text-align: center;
		margin-block-end: var(--space-xl);
	}

	section {
		padding-block-end: var(--space-xl);
	}
</style>
