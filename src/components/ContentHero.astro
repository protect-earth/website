---
import { Image } from 'astro:assets';
const { imgAlt, imgSrc, title, variant = '', backgroundColor } = Astro.props;

if (imgSrc && !imgAlt) {
	throw new Error('ContentHero requires imgAlt when imgSrc is provided.');
}
---

<header
	class="content-hero"
	data-variant={variant || undefined}
	style={{ backgroundColor: backgroundColor }}
>
	<div class="wrap">
		<h1>{title}</h1>
		<slot />
	</div>

	<div class="background-canvas">
		{imgSrc && <Image src={imgSrc} loading="eager" alt={imgAlt} />}
	</div>
</header>

<style>
	.content-hero {
		background: var(--content-hero);
		color: var(--body-text-light);
		clip-path: var(--wavy-line-top-bottom);
		position: relative;
		isolation: isolate;
		padding-block: var(--space-3xl);
		overflow: hidden;
	}

	h1 {
		font-size: var(--font-4xl);
		margin-block-end: var(--space-s);
	}

	.wrap {
		display: flex;
		flex-flow: column;
		justify-content: center;
		align-items: center;
		position: relative;
		z-index: 1;
		font-size: var(--font-m);

		p {
			display: inline-flex;
			gap: var(--space-2xs);
			text-align: center;
			max-inline-size: var(--measure);
		}
	}

	.background-canvas {
		position: absolute;
		inset: 0;
		display: flex;
		justify-content: center;
		align-items: center;
		z-index: 0;

		img {
			block-size: 100%;
			inline-size: 100%;
			object-fit: cover;
			filter: opacity(0.5) grayscale(1);
		}
	}

	h1 {
		text-align: center;
	}
</style>
