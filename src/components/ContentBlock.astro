---
import { Image } from 'astro:assets';
const { imgAlt, imgSrc, isReversed, linkHref, linkTarget, linkText, title, variant } = Astro.props;
---

<section
	class="content-block"
	data-direction={isReversed ? 'reversed' : undefined}
	data-variant={variant}
>
	{
		imgSrc && (
			<figure>
				<Image src={imgSrc} alt={imgAlt} inferSize densities={[1.5, 2]} class="squircle" />
			</figure>
		)
	}

	<div class="prose stack">
		<h2>{title}</h2>
		<slot />

		{
			linkHref && (
				<div class="cta">
					<a
						class="button"
						href={linkHref}
						target={linkTarget}
						rel={linkTarget === '_blank' ? 'noopener noreferrer' : undefined}
					>
						{linkText}
					</a>
				</div>
			)
		}
	</div>
</section>

<style>
	.content-block {
		display: flex;
		flex-flow: row;
		gap: var(--space-xl);
		margin-block-start: var(--space-xl);
		@media screen and (max-width: 844px) {
			flex-flow: column-reverse;
			gap: var(--space-m);
		}
	}

	.content-block:first-of-type {
		margin-block-start: 0;
	}

	h2 {
		font-size: var(--font-xl);
	}

	.prose {
		flex: 3;
	}

	figure {
		flex: 2;
	}

	img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.content-block[data-direction='reversed'] {
		flex-flow: row-reverse;
		@media screen and (max-width: 844px) {
			flex-flow: column-reverse;
		}
	}
</style>
