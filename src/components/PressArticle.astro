---
import type { CollectionEntry } from 'astro:content';
type Props = CollectionEntry<'press'>['data'][0];

const { title, source, url, image, imageAlt, description, date } = Astro.props;
---

<article class="press-article">
	<figure>
		<img class="squircle" src={image} alt={imageAlt} />
	</figure>

	<header>
		<h2>{title}</h2>
		<ul>
			<li><strong>{source}</strong></li>

			<li>
				<time datetime={date.toISOString()}>
					{
						date.toLocaleDateString('en-GB', {
							day: 'numeric',
							month: 'long',
							year: 'numeric',
						})
					}
				</time>
			</li>
		</ul>
	</header>

	<div class="desc">
		<p class="prose">{description}</p>
	</div>

	<a class="button" href={url} target="_blank" rel="noopener"> Read article </a>
</article>

<style>
	.press-article {
		display: flex;
		flex-flow: column;
		gap: var(--space-xs);
	}

	.desc {
		flex: 1;
		display: flex;
		flex-flow: column;
		gap: var(--space-2xs);
		margin-block-end: var(--space-xs);
	}

	dl {
		margin: 0;
	}

	dd {
		margin: 0;
	}

	h2 {
		margin-block: 0 var(--space-xs);
		font-size: var(--font-s);
		font-weight: 700;
	}

	.prose {
		margin-block: 0;
		font-size: var(--font-xs);
	}

	img {
		aspect-ratio: 3/2;
		width: 100%;
		object-fit: cover;
	}

	.button {
		align-self: flex-start;
	}
</style>
