---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
type Props = CollectionEntry<'members'>['data'][0];

const { name, role, image, imageAlt, bio } = Astro.props;
---

<article class="team-member">
	<Image src={image} alt={imageAlt} inferSize class="squircle" />

	<div class="content">
		<header>
			<h2>{name}</h2>
			<p aria-label="Role:">{role}</p>
		</header>

		<div class="prose stack">
			{bio.split('\n\n').map((paragraph: string) => <p>{paragraph}</p>)}
		</div>
	</div>
</article>

<style>
	.team-member {
		display: grid;
		grid-template-columns: 350px 1fr;
		gap: var(--space-2xl);
		@media screen and (max-width: 844px) {
			grid-template-columns: 1fr;
			gap: var(--space-m);
		}
	}

	h2 {
		margin-block: 0 var(--space-3xs);
		font-size: var(--font-xl);
	}

	header {
		margin-block-end: var(--space-s);
	}

	header p {
		color: var(--accent);
		font-size: var(--font-xs);
		margin-block: 0;
	}

	img {
		aspect-ratio: 1/1;
		max-inline-size: 24rem;
		overflow: hidden;
		object-fit: cover;
	}
</style>
